# Copy to .env at the repository root. Never use VITE_* for secrets.
# Existing robot sensor token (optional).
HURT_TOKEN=

# Required: shared by backend and AI worker, not sent to the browser.
# Generate with: openssl rand -hex 32
OBSERVATION_TOKEN=
# Required: Claude API key from Anthropic Console.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Required for AI monitor administrator login: a different random code, 24–256 characters.
ADMIN_ACCESS_TOKEN=

# Browser origins, comma-separated without trailing slashes.
AI_ALLOWED_ORIGINS=https://n.joun.cc
AI_ADMIN_ORIGINS=https://n.joun.cc

# Required for Instagram publishing: Meta App > Basic and Unified Login configuration.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_CONFIG_ID=
# Enter the Graph API version supported by your Meta app.
INSTAGRAM_API_VERSION=v26.0
# Same HTTPS domain as the robot frontend; register this exact callback in Meta.
INSTAGRAM_REDIRECT_URI=https://n.joun.cc/api/instagram/callback
INSTAGRAM_MEDIA_ORIGIN=https://n.joun.cc
# Optional separate image signing key; defaults to META_APP_SECRET.
PUBLISH_MEDIA_SECRET=

# Legacy Instagram Login alternative, only if Unified Login is not configured.
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
