{
  "name": "robot-face-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev -w @robot-face/frontend\" \"npm run dev -w @robot-face/backend\"",
    "dev:frontend": "npm run dev -w @robot-face/frontend",
    "dev:backend": "npm run dev -w @robot-face/backend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @robot-face/backend",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
